# Stripe Checkout. Without STRIPE_SECRET_KEY, the Stripe button displays a clear "not configured" message.
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional: pre-created Stripe Price. If omitted, the API creates inline price_data for INR 500.
STRIPE_PRICE_ID=

# Used for fallback redirects if the request origin header is missing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Strong random string used to sign the premium access cookie.
# Example: openssl rand -hex 32
PREMIUM_COOKIE_SECRET=replace_with_a_long_random_secret
